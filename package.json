{
  "name": "driverfund",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "vercel-build": "expo export -p web",
    "deploy": "expo export -p web --output-dir dist && mkdir -p dist/.vercel && cp .vercel/project.json dist/.vercel/project.json && cp vercel.json dist/vercel.json && cd dist && npx vercel --prod --yes"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@stripe/stripe-react-native": "0.50.3",
    "@supabase/supabase-js": "^2.105.1",
    "expo": "~55.0.0",
    "expo-image-picker": "~17.0.11",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-native": "^0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
